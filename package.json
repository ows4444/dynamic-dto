  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --config test/jest.config.json",
    "test:unit": "jest --config test/jest-unit.json --runInBand",
    "test:int": "jest --config test/jest-integration.json --runInBand",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "test:all": "npm run test:unit && npm run test:int && npm run test:e2e",
    "test:all:cov": "npm run test:cov:unit && npm run test:cov:int && npm run test:cov:e2e",
    "test:cov": "jest --config test/jest.config.json --coverage",
    "test:cov:unit": "jest --config test/jest-unit.json --coverage",
    "test:cov:int": "jest --config test/jest-integration.json --coverage",
    "test:cov:e2e": "jest --config test/jest-e2e.json --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
